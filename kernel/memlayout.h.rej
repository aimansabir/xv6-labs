*** kernel/memlayout.h
--- kernel/memlayout.h
***************
*** 69,74 ****
  // map the trampoline page to the highest address,
  // in both user and kernel space.
  #define TRAMPOLINE (MAXVA - PGSIZE)
  #define PLIC       0x0c000000L
  #define UART0      0x10000000L
  #define VIRTIO0    0x10001000L
--- 69,87 ----
  // map the trampoline page to the highest address,
  // in both user and kernel space.
  #define TRAMPOLINE (MAXVA - PGSIZE)
+ 
+ // The per-process user-accessible, read-only "usyscall" page lives
+ // one page below the trapframe.
+ // User code can read fields here without a system call.
+ #define USYSCALL   (TRAPFRAME - PGSIZE)
+ 
+ // Minimal data exposed to user via USYSCALL.
+ // Keep this tiny: it should fit comfortably in a single page,
+ // but we only rely on 'pid' for this lab.
+ struct usyscall {
+   int pid;
+ };
+ 
  #define PLIC       0x0c000000L
  #define UART0      0x10000000L
  #define VIRTIO0    0x10001000L
